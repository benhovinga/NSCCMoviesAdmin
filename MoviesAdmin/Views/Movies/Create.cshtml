@model MoviesAdmin.Models.Movie

@{
    ViewData["Title"] = "Add new movie";
}

<h1 class="display-1 ">Movies</h1>

<h4>Add new movie</h4>
<hr />
<div class="row">
    <div class="col-md-6 col-lg-4">
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Synopsis" class="form-label"></label>
                <textarea rows="3" asp-for="Synopsis" class="form-control"></textarea>
                <span asp-validation-for="Synopsis" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="GenreId" class="form-label"></label>
                <select asp-for="GenreId" class="form-control form-select" asp-items="ViewBag.GenreId">
                    <option value="">-- Select a Genre --</option>
                </select>
                <span asp-validation-for="GenreId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="AudienceRatingId" class="form-label"></label>
                <select asp-for="AudienceRatingId" class="form-control form-select" asp-items="ViewBag.AudienceRatingId">
                    <option value="">-- Select a Rating --</option>
                </select>
                <span asp-validation-for="AudienceRatingId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Runtime" class="form-label"></label>
                <input asp-for="Runtime" class="form-control" />
                <span asp-validation-for="Runtime" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ReleaseDate" class="form-label"></label>
                <input type="date" asp-for="ReleaseDate" class="form-control" />
                <span asp-validation-for="ReleaseDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Director" class="form-label"></label>
                <input asp-for="Director" class="form-control" />
                <span asp-validation-for="Director" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Producer" class="form-label"></label>
                <input asp-for="Producer" class="form-control" />
                <span asp-validation-for="Producer" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Distributor" class="form-label"></label>
                <input asp-for="Distributor" class="form-control" />
                <span asp-validation-for="Distributor" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="OriginalLanguage" class="form-label"></label>
                <input asp-for="OriginalLanguage" class="form-control" />
                <span asp-validation-for="OriginalLanguage" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label for="PosterFile" class="form-label">Poster Image</label>
                <input type="file" id="PosterFile" name="PosterFile" class="form-control" />
                <input type="hidden" asp-for="PosterUrl" />
                <span asp-validation-for="PosterUrl" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary">
                    <svg class="bi" aria-hidden="true"><use href="#plus-circle"></use></svg>
                    Create
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    <svg class="bi me-1" aria-hidden="true"><use href="#x-lg"></use></svg>
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>
