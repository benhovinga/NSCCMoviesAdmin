@model MoviesAdmin.Models.Movie

@{
    ViewData["Title"] = $"{Model.Title} ({Model.ReleaseDate.Year})";
    //var genres = Model.Genre.Split(',');
}

<div class="container">
    <h2 class="display-3">@Model.Title</h2>
    <p><small>@Model.ReleaseDate.Year • @Model.Rating • @(Model.Runtime)m</small></p>
    <hr />

    <img src="@Model.PosterUrl" alt="@Model.Title" width="300" class="mx-auto d-block float-md-end ps-0 ps-md-3" />
    
    <div class="mb-3">
        @* @foreach (var genre in genres)
        {
            <span class="badge text-bg-secondary">@genre.Trim()</span>
        } *@
    </div>

    <p>
        @Html.DisplayFor(model => model.Synopsis)
    </p>

    <div class="table d-inline">
        <dl class="row">
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.ReleaseDate)
            </dt>
            <dd class="col-sm-5">
                @Html.DisplayFor(model => model.ReleaseDate)
            </dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Director)
            </dt>
            <dd class="col-sm-5">
                @Html.DisplayFor(model => model.Director)
            </dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Producer)
            </dt>
            <dd class="col-sm-5">
                @Html.DisplayFor(model => model.Producer)
            </dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Distributor)
            </dt>
            <dd class="col-sm-5">
                @Html.DisplayFor(model => model.Distributor)
            </dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.OriginalLanguage)
            </dt>
            <dd class="col-sm-5">
                @Html.DisplayFor(model => model.OriginalLanguage)
            </dd>
        </dl>
    </div>
    <div>
        <a asp-action="Edit" asp-route-id="@Model?.MovieId" class="btn btn-primary">
            <svg class="bi me-1" aria-hidden="true"><use href="#pencil"></use></svg>
            Edit
        </a>

        <a asp-action="Index" class="btn btn-secondary">
            Go back to list
        </a>
    </div>
</div>

