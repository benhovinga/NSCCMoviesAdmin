@model IEnumerable<MoviesAdmin.Models.Movie>

@{
    ViewData["Title"] = "Movies";
}

<h1 class="display-1">Movies</h1>

<p class="text-end">
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle" aria-hidden="true"></i>
        Add Movie
    </a>
</p>
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th scope="col" width="20%">
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th scope="col">
                @Html.DisplayNameFor(model => model.Synopsis)
            </th>
            <th scope="col">
                @Html.DisplayNameFor(model => model.Genre)
            </th>
            <th scope="col">
                @Html.DisplayNameFor(model => model.Rating)
            </th>
            <th scope="col" class="no-wrap">
                @Html.DisplayNameFor(model => model.ReleaseDate)
            </th>
            <th scope="col">
                <!-- Actions column -->
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <th scope="row">
                <a asp-action="Details" asp-route-id="@item.Id">@Html.DisplayFor(model => item.Title)</a>
            </th>
            <td>
                @Html.DisplayFor(model => item.Synopsis)
            </td>
            <td>
                @Html.DisplayFor(model => item.Genre)
            </td>
            <td>
                @Html.DisplayFor(model => item.Rating)
            </td>
            <td class="no-wrap">
                @Html.DisplayFor(model => item.ReleaseDate)
            </td>
            <td class="no-wrap">
                <div class="btn-group" role="group">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary">
                        <i class="bi bi-pencil" aria-hidden="true"></i>
                        Edit
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">
                        <i class="bi bi-trash3" aria-hidden="true"></i>
                        Delete
                    </a>
                </div>
            </td>
        </tr>
}
    </tbody>
</table>
