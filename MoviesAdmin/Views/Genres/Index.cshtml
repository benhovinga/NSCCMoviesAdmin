@model IEnumerable<MoviesAdmin.Models.Genre>

@{
    ViewData["Title"] = "Index";
}

<h1 class="display-1">Genres</h1>

<p class="text-end">
    <a asp-action="Create" class="btn btn-primary" title="Add Genre">
        <svg class="bi" aria-hidden="true"><use href="#plus-circle"></use></svg>
        Add Genre
    </a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Movies)
            </th>
            <th>
                <!-- Action Column -->
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                <a asp-action="Details" asp-route-id="@item.GenreId">@Html.DisplayFor(model => item.Title)</a>
            </td>
            <td>
               @Html.DisplayFor(model => @item.Movies.Count)
            </td>
            <td>
                <div class="btn-group btn-group-sm" role="group">
                    <a asp-action="Edit" asp-route-id="@item.GenreId" class="btn btn-secondary" title="Edit Genre">
                        <svg class="bi" aria-hidden="true"><use href="#pencil"></use></svg>
                        Edit
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.GenreId" class="btn btn-danger" title="Delete Genre">
                        <svg class="bi" aria-hidden="true"><use href="#trash3"></use></svg>
                        <span class="visually-hidden">Delete</span>
                    </a>
                </div>
            </td>
        </tr>
}
    </tbody>
</table>
