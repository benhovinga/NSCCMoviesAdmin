@model IEnumerable<MoviesAdmin.Models.CriticReview>

@{
    ViewData["Title"] = "My Reviews";
}

<h1>My Reviews</h1>

<p class="text-end">
    <a asp-action="Create" class="btn btn-primary">
        <svg class="bi" aria-hidden="true"><use href="#plus-circle"></use></svg>
        Create Review
    </a>
</p>

<table class="table table-striped table-hover">
@foreach (var item in Model) {    
    <tr>
        <td class="row">
            <div class="col position-relative">
                <div class="pb-2">
                    <strong><a asp-action="Details" asp-route-id="@item.CriticReviewId">@Html.DisplayFor(model => item.Movie.Title)</a></strong>

                    @if (item.IsPublished)
                    {
                        <span class="ms-3 badge text-bg-success">Public</span>
                    }
                    else
                    {
                        <span class="ms-3 badge text-bg-secondary">Draft</span>
                    }
                </div>

                <div class="pb-2">
                    <div class="rating">
                    @for (int i = 5; i >= 1; i--)
                    {
                        <input 
                            type="radio" 
                            id="star@(item.CriticReviewId).@(i)" 
                            name="Rating@(item.CriticReviewId)" 
                            value="@(i)" 
                            disabled
                            @if(item.Rating == i) { @("checked") }
                        />
                        <label for="star@(item.CriticReviewId).@(i)">@(i) Star</label>
                    }
                    </div>
                    <div class="clearfix"></div>
                </div>

                <p class="mb-5">@Html.DisplayFor(model => item.Review)</p>

                @if (!item.IsPublished)
                {
                    <div class="btn-group position-absolute bottom-0 end-0" role="group">
                        <a asp-action="Edit" asp-route-id="@item.CriticReviewId" class="btn btn-secondary" title="Edit Movie">
                            <svg class="bi" aria-hidden="true"><use href="#pencil"></use></svg>
                            Edit
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.CriticReviewId" class="btn btn-danger" title="Delete Movie">
                            <svg class="bi" aria-hidden="true"><use href="#trash3"></use></svg>
                            <span class="visually-hidden">Delete</span>
                        </a>
                    </div>
                }
            </div>
        </td>
    </tr>
}
</table>
